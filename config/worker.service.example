[Unit]
Description=Phonic LiveKit Worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonic-worker
EnvironmentFile=/root/phonic-worker/.env
ExecStart=/usr/bin/node agent.js start
Restart=always
RestartSec=5
StandardOutput=append:/var/log/voice-worker.log
StandardError=append:/var/log/voice-worker.log

[Install]
WantedBy=multi-user.target
